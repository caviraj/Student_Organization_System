# Copy to .env and edit. .env is gitignored - never commit real secrets.

# --- Database ---------------------------------------------------------------------
# Dev default is SQLite so the API, tests and seed run with zero setup.
DATABASE_URL=sqlite:///./ssa_hub.db
# Deployed target (DESIGN.md §3). Local Docker Postgres:
# DATABASE_URL=postgresql+psycopg://ssa:ssa@localhost:5432/ssa_hub
# Supabase, e.g.:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth -------------------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=10080

# bcrypt cost. Lower it (e.g. 4) only to make test suites fast.
BCRYPT_ROUNDS=12

# --- CORS -------------------------------------------------------------------------
# Comma-separated origins of the SPA.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeded accounts (scripts/seed.py) --------------------------------------------
# Password for every seeded account: Passw0rd!
#   admin@ssa.org, treasurer@ssa.org, organizer@ssa.org, volunteer@ssa.org
#   member01@ssa.org ... member20@ssa.org

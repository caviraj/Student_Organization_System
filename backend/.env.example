# Copy to .env and edit. .env is gitignored - never commit real secrets.

# --- Database ---------------------------------------------------------------------
# Supabase needs TWO connection strings - they are not interchangeable (core/db.py):
#   DATABASE_URL  app traffic   -> TRANSACTION pooler, port 6543
#   DIRECT_URL    migrations/seed -> SESSION pooler or direct, port 5432
# The transaction pooler can hand each statement to a different backend, so the engine disables
# prepared statements and the app must avoid advisory locks / session-level state.
SUPABASE_REF=your-project-ref
SUPABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
# Note the `%40` for `@` in the password.
DATABASE_URL=postgresql+psycopg://postgres.${SUPABASE_REF}:<password>@${SUPABASE_HOST}:6543/postgres
DIRECT_URL=postgresql+psycopg://postgres.${SUPABASE_REF}:<password>@${SUPABASE_HOST}:5432/postgres
# Tests create and TRUNCATE their own tables, so they need a separate database.
# conftest.py aborts the run if this is missing or points at DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://postgres.${SUPABASE_REF}:<password>@${SUPABASE_HOST}:5432/ssa_hub_test

# The default in core/config.py is a local SQLite file so a bare `uvicorn` boots with no setup.
# Postgres is the only supported target for real work: the tests need it (they build their schema
# with the real migrations and truncate between cases), and nothing in app code may assume SQLite.
# DATABASE_URL=sqlite:///./ssa_hub.db
# Local Docker Postgres (DIRECT_URL can be left unset - it falls back to DATABASE_URL):
# DATABASE_URL=postgresql+psycopg://ssa:ssa@localhost:5432/ssa_hub
# TEST_DATABASE_URL=postgresql+psycopg://ssa:ssa@localhost:5432/ssa_hub_test

# --- Auth -------------------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=10080
# How long an unsubscribe link in an email stays valid.
UNSUBSCRIBE_TOKEN_DAYS=3650

# bcrypt cost. Lower it (e.g. 4) only to make test suites fast.
BCRYPT_ROUNDS=12

# --- CORS -------------------------------------------------------------------------
# Comma-separated origins of the SPA.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Announcements (Phase 3) -------------------------------------------------------
# Public URL of the SPA - announcement emails link back to it.
FRONTEND_URL=http://localhost:5173
# console (logs the email, simulates success) | M2: resend, smtp
EMAIL_PROVIDER=console

# --- Merchandise (Phase 4) ---------------------------------------------------------
# Merch is members-only by default (PRD FR-4.1). Set false to let anyone order at list price.
MERCH_MEMBERS_ONLY=true

# --- Receipt storage (Phase 6) -----------------------------------------------------
# Receipts live in a PRIVATE Supabase Storage bucket, reached only by this backend. The
# service-role key bypasses RLS, so it is never logged, never returned and never committed -
# clients get a signed URL that expires in 10 minutes instead.
# local (a fake rooted at LOCAL_STORAGE_DIR - dev and tests) | supabase (real)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=var/storage
# Required when STORAGE_PROVIDER=supabase. Run `python scripts/setup_storage.py` to create the
# bucket; it fails if the bucket exists and is public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RECEIPTS_BUCKET=receipts

# --- Seeded accounts (scripts/seed.py) --------------------------------------------
# Password for every seeded account: Passw0rd!
#   admin@ssa.org, treasurer@ssa.org, organizer@ssa.org, volunteer@ssa.org
#   neha@ssa.org, rohit@ssa.org (Phase 6 claimants), member01@ssa.org ... member20@ssa.org
